# Runtime
NODE_ENV=development
PORT=3000

# Storage
DATABASE_PATH=./production-dashboard.sqlite
DATABASE_BACKUP_DIR=./database-backups
LEGACY_HISTORY_DIR=./history
DATABASE_BACKUP_RETENTION_DAYS=7

# Replace this value with a long random secret.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false

# Login protection
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=50

# Enable these settings behind an HTTPS reverse proxy.
# NODE_ENV=production
# SESSION_COOKIE_SECURE=true
# TRUST_PROXY=1

# Optional bootstrap passwords, read only when the database is initialized.
# DEFAULT_ADMIN_PASSWORD=
# DEFAULT_ADMIN_OPERATOR_PASSWORD=
# DEFAULT_OPERATOR_PASSWORD=
