{
  "name": "production-dashboard",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.3",
  "main": "server.js",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles/tailwind.css -o public/assets/css/tailwind.css --minify",
    "start": "node server.js",
    "check": "npm run check:server && npm run check:client && npm run check:test && npm run check:assets",
    "check:assets": "node scripts/check-assets.js",
    "check:server": "node scripts/check-syntax.js server.js ecosystem.config.js src scripts",
    "check:client": "node scripts/check-syntax.js public/assets/js",
    "check:test": "node scripts/check-syntax.js test",
    "test": "npm run check && node --test --test-concurrency=1 test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "sequelize": "^6.37.7",
    "sqlite3": "^6.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ],
    "overrides": {
      "body-parser": "2.3.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "qs": "6.15.3",
      "tmp": "0.2.7",
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fortawesome/fontawesome-free": "6.5.2",
    "alpinejs": "3.15.12",
    "chart.js": "4.5.1",
    "tailwindcss": "3.4.17"
  }
}
